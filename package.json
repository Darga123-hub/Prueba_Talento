    "@vercel/blob": "^2.4.0",
    "@vercel/functions": "^3.3.1",
    "cookie": "^1.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.8.3",
    "jose": "6.1.3",
    "lucide-react": "^0.562.0",
    "pg": "^8.16.3",
